[TEMPLATE]
[TEMPLATE]
# Frontend (Vite) — copied to .env.local or passed at build time.
# Where the Conduit backend lives.
#   - Leave empty (default) to talk to the SAME origin (dev Vite proxy, or the
#     nginx proxy in deploy/nginx.conf).
#   - Set an absolute URL to hit the backend directly from another origin,
#     e.g. https://api.conduit.example.com (the backend already sends CORS headers).
# WebSocket URLs are derived from this automatically (https -> wss).
VITE_API_BASE=

# WebRTC ICE servers (JSON array of RTCIceServer).
# Empty (default) = public STUN only — fine for most NATs and same-network peers.
# For reliable cross-device, cross-network transfer of LARGE files, add a TURN
# relay so peers behind restrictive NATs/firewalls can still connect, e.g.:
#   VITE_ICE_SERVERS=[{"urls":"turn:relay.metered.ca:80","username":"u","credential":"p"}]
VITE_ICE_SERVERS=

# Backend (server/.env.example) — PORT, HOST, DATABASE_URL
#   ADMIN_PASSWORD  — admin console password; defaults to CONDUIT@2026 when unset
