[TEMPLATE]
# Conduit backend (Fastify). Copy to server/.env for local dev.
# In production these are injected by the platform (Render/Railway/Fly set PORT).

HOST=0.0.0.0
PORT=8787

# PostgreSQL connection string. When set, the server applies server/src/db/schema.sql
# automatically on boot (idempotent, safe every start). When unset, an in-memory
# store is used — fine for a demo, but data is lost on restart.
# DATABASE_URL=postgres://user:pass@host:5432/conduit?sslmode=require

# Admin console password (sign in at /admin from the site).
# Unset -> defaults to CONDUIT@2026. Override for a custom password, or set
# ADMIN_PASSWORD= (empty) to disable the admin API entirely.
# ADMIN_PASSWORD=
